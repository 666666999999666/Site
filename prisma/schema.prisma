// Prisma 7 schema (Rust-free client, driver adapter required at runtime)
// Docs: https://www.prisma.io/docs/orm/v6/prisma-schema/overview/generators

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

// NOTE: In Prisma 7, `datasource.url` moved to `prisma.config.ts`.
datasource db {
  provider = "postgresql"
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

enum TodoStatus {
  TODO
  DONE
}

enum CategoryType {
  BLOG
  TODO
}

enum McpApprovalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum McpCredentialKind {
  STATIC
  OAUTH
}

enum McpAuditStatus {
  IN_PROGRESS
  SUCCESS
  FAILURE
  INTERRUPTED
}

model Post {
  id            String     @id @default(cuid())
  title         String
  content       String     @db.Text
  excerpt       String?
  slug          String     @unique
  categoryId    String?
  category      Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags          String[]
  coverImage    String?
  draftMetadata Json?
  status        PostStatus @default(DRAFT)
  readTime      Int        @default(1)
  publishedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([status, createdAt])
  @@index([categoryId])
}

model Category {
  id          String       @id @default(cuid())
  name        String
  type        CategoryType
  description String?
  color       String?      @default("#C97B3D")
  sortOrder   Int          @default(0)
  posts       Post[]
  todos       Todo[]
  createdAt   DateTime     @default(now())

  @@unique([type, name])
  @@index([type])
}

model Todo {
  id          String     @id @default(cuid())
  title       String
  description String?
  categoryId  String?
  category    Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  status      TodoStatus @default(TODO)
  priority    Int        @default(0)
  dueDate     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  dailyTasks  DailyTask[]

  @@index([status])
  @@index([categoryId])
}

model User {
  id              String   @id @default(cuid())
  username        String   @unique
  passwordHash    String
  passwordVersion Int      @default(1)
  name            String
  email           String   @unique
  emailVerified   Boolean  @default(true)
  image           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  accounts           Account[]
  sessions           Session[]
  oauthClients       OauthClient[]
  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]
  oauthConsents      OauthConsent[]
  dailyPlans         DailyPlan[]
}

model DailyQuote {
  id             Int       @id @default(autoincrement())
  quote          String    @db.Text
  category       String    @db.VarChar(32)
  author         String?   @db.VarChar(120)
  source         String?   @db.VarChar(200)
  sourceDetail   String?   @map("source_detail") @db.VarChar(200)
  usedDate       DateTime? @unique @map("used_date") @db.Date
  normalizedHash String    @unique @map("normalized_hash") @db.VarChar(64)
  status         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  plans          DailyPlan[]

  @@index([status, category])
  @@map("daily_quotes")
}

model DailyPlan {
  id            String      @id @default(cuid())
  userId        String      @map("user_id")
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  planDate      DateTime    @map("plan_date") @db.Date
  quoteId       Int?        @map("quote_id")
  quote         DailyQuote? @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  quoteText     String      @map("quote_text") @db.Text
  quoteCategory String      @map("quote_category") @db.VarChar(32)
  quoteAuthor   String?     @map("quote_author") @db.VarChar(120)
  quoteSource   String?     @map("quote_source") @db.VarChar(200)
  quoteSourceDetail String? @map("quote_source_detail") @db.VarChar(200)
  tasks         DailyTask[]
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@unique([userId, planDate])
  @@index([userId, planDate(sort: Desc)])
  @@map("daily_plans")
}

model DailyTask {
  id           String    @id @default(cuid())
  planId       String    @map("plan_id")
  plan         DailyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  slot         Int
  title        String    @db.VarChar(300)
  completedAt  DateTime? @map("completed_at")
  sourceTodoId String?   @map("source_todo_id")
  sourceTodo   Todo?     @relation(fields: [sourceTodoId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([planId, slot])
  @@unique([planId, sourceTodoId])
  @@index([sourceTodoId])
  @@map("daily_tasks")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Jwks {
  id         String    @id @default(cuid())
  publicKey  String    @db.Text
  privateKey String    @db.Text
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?
}

model OauthClient {
  id                      String   @id @default(cuid())
  clientId                String   @unique
  clientSecret            String?
  disabled                Boolean  @default(false)
  skipConsent             Boolean?
  enableEndSession        Boolean?
  subjectType             String?
  scopes                  String[]  @default([])
  userId                  String?
  user                    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  name                    String?
  uri                     String?
  icon                    String?
  contacts                String[]  @default([])
  tos                     String?
  policy                  String?
  softwareId              String?
  softwareVersion         String?
  softwareStatement       String?
  redirectUris            String[]
  postLogoutRedirectUris  String[]  @default([])
  tokenEndpointAuthMethod String?
  grantTypes              String[]  @default([])
  responseTypes           String[]  @default([])
  public                  Boolean  @default(true)
  type                    String?
  requirePKCE             Boolean  @default(true)
  referenceId             String?
  metadata                Json?

  refreshTokens OauthRefreshToken[]
  accessTokens  OauthAccessToken[]
  consents      OauthConsent[]

  @@index([userId])
  @@index([createdAt])
}

model OauthRefreshToken {
  id          String      @id @default(cuid())
  token       String      @unique
  clientId    String
  client      OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId   String?
  session     Session?    @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId String?
  expiresAt   DateTime
  createdAt   DateTime    @default(now())
  revoked     DateTime?
  authTime    DateTime?
  scopes      String[]

  accessTokens OauthAccessToken[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([expiresAt])
}

model OauthAccessToken {
  id          String             @id @default(cuid())
  token       String             @unique
  clientId    String
  client      OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId   String?
  session     Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId      String?
  user        User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId String?
  refreshId   String?
  refresh     OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  createdAt   DateTime           @default(now())
  scopes      String[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([refreshId])
  @@index([expiresAt])
}

model OauthConsent {
  id          String      @id @default(cuid())
  clientId    String
  client      OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId String?
  scopes      String[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([clientId, userId])
  @@index([clientId])
  @@index([userId])
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String?
  tags        String[]
  coverImage  String?
  sourceUrl   String?
  demoUrl     String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
}

model McpCredential {
  id            String            @id
  kind          McpCredentialKind @default(STATIC)
  name          String
  secretHash    String?
  oauthClientId String?           @unique
  oauthSubject  String?
  scopes        String[]
  revokedAt     DateTime?
  lastUsedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  approvals     McpApproval[]
  auditLogs     McpAuditLog[]
  rateLimits    McpRateLimit[]
  importBundles McpImportBundle[]

  @@index([revokedAt])
  @@index([kind, revokedAt])
}

model McpApproval {
  id               String            @id @default(cuid())
  credentialId     String
  credential       McpCredential     @relation(fields: [credentialId], references: [id], onDelete: Restrict)
  toolName         String
  requiredScope    String
  status           McpApprovalStatus @default(PENDING_APPROVAL)
  payload          Json
  parameterSummary Json
  resultSummary    Json?
  executionError   String?
  processingAt     DateTime?
  reviewedAt       DateTime?
  executedAt       DateTime?
  expiresAt        DateTime
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  execution        McpExecution?
  importBundle     McpImportBundle?

  @@index([status, createdAt])
  @@index([credentialId, createdAt])
}

model McpImportBundle {
  id              String        @id
  credentialId    String
  credential      McpCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  sourceFile      String
  sourceDigest    String
  manifest        Json
  uploadTokenHash String
  approvalId      String?       @unique
  approval        McpApproval?  @relation(fields: [approvalId], references: [id], onDelete: Restrict)
  expiresAt       DateTime
  consumedAt      DateTime?
  cleanedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([credentialId, createdAt])
  @@index([expiresAt, cleanedAt])
}

model McpExecution {
  approvalId    String      @id
  approval      McpApproval @relation(fields: [approvalId], references: [id], onDelete: Restrict)
  toolName      String
  resultSummary Json
  createdAt     DateTime    @default(now())
}

model McpAuditLog {
  id               String         @id @default(cuid())
  credentialId     String?
  credential       McpCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  toolName         String
  parameterSummary Json
  resultSummary    Json?
  status           McpAuditStatus @default(IN_PROGRESS)
  success          Boolean
  errorCode        String?
  errorMessage     String?
  createdAt        DateTime       @default(now())
  completedAt      DateTime?

  @@index([credentialId, createdAt])
  @@index([toolName, createdAt])
  @@index([status, createdAt])
}

model McpRateLimit {
  credentialId String
  credential   McpCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  toolName     String
  windowStart  DateTime
  count        Int           @default(0)

  @@id([credentialId, toolName, windowStart])
  @@index([windowStart])
}
