// Prisma 7 schema (Rust-free client, driver adapter required at runtime)
// Docs: https://www.prisma.io/docs/orm/v6/prisma-schema/overview/generators

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

// NOTE: In Prisma 7, `datasource.url` moved to `prisma.config.ts`.
datasource db {
  provider = "postgresql"
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

enum TodoStatus {
  TODO
  DONE
}

enum CategoryType {
  BLOG
  TODO
}

enum McpApprovalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

model Post {
  id            String     @id @default(cuid())
  title         String
  content       String     @db.Text
  excerpt       String?
  slug          String     @unique
  categoryId    String?
  category      Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags          String[]
  coverImage    String?
  draftMetadata Json?
  status        PostStatus @default(DRAFT)
  readTime      Int        @default(1)
  publishedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([status, createdAt])
  @@index([categoryId])
}

model Category {
  id          String       @id @default(cuid())
  name        String
  type        CategoryType
  description String?
  color       String?      @default("#C97B3D")
  sortOrder   Int          @default(0)
  posts       Post[]
  todos       Todo[]
  createdAt   DateTime     @default(now())

  @@unique([type, name])
  @@index([type])
}

model Todo {
  id          String     @id @default(cuid())
  title       String
  description String?
  categoryId  String?
  category    Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  status      TodoStatus @default(TODO)
  priority    Int        @default(0)
  dueDate     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status])
  @@index([categoryId])
}

model User {
  id              String   @id @default(cuid())
  username        String   @unique
  passwordHash    String
  passwordVersion Int      @default(1)
  createdAt       DateTime @default(now())
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String?
  tags        String[]
  coverImage  String?
  sourceUrl   String?
  demoUrl     String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
}

model McpCredential {
  id         String    @id
  name       String
  secretHash String
  scopes     String[]
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  approvals  McpApproval[]
  auditLogs  McpAuditLog[]
  rateLimits McpRateLimit[]

  @@index([revokedAt])
}

model McpApproval {
  id               String            @id @default(cuid())
  credentialId     String
  credential       McpCredential     @relation(fields: [credentialId], references: [id], onDelete: Restrict)
  toolName         String
  requiredScope    String
  status           McpApprovalStatus @default(PENDING_APPROVAL)
  payload          Json
  parameterSummary Json
  resultSummary    Json?
  executionError   String?
  processingAt     DateTime?
  reviewedAt       DateTime?
  executedAt       DateTime?
  expiresAt        DateTime
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  execution        McpExecution?

  @@index([status, createdAt])
  @@index([credentialId, createdAt])
}

model McpExecution {
  approvalId    String      @id
  approval      McpApproval @relation(fields: [approvalId], references: [id], onDelete: Restrict)
  toolName      String
  resultSummary Json
  createdAt     DateTime    @default(now())
}

model McpAuditLog {
  id               String         @id @default(cuid())
  credentialId     String?
  credential       McpCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  toolName         String
  parameterSummary Json
  resultSummary    Json?
  success          Boolean
  errorCode        String?
  errorMessage     String?
  createdAt        DateTime       @default(now())

  @@index([credentialId, createdAt])
  @@index([toolName, createdAt])
}

model McpRateLimit {
  credentialId String
  credential   McpCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  toolName     String
  windowStart  DateTime
  count        Int           @default(0)

  @@id([credentialId, toolName, windowStart])
  @@index([windowStart])
}
