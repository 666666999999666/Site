// Prisma 7 schema (Rust-free client, driver adapter required at runtime)
// Docs: https://www.prisma.io/docs/orm/v6/prisma-schema/overview/generators

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

// NOTE: In Prisma 7, `datasource.url` moved to `prisma.config.ts`.
datasource db {
  provider = "postgresql"
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

enum TodoStatus {
  TODO
  DONE
}

enum CategoryType {
  BLOG
  TODO
}

enum InboxKind {
  BLOG
  IDEA
  TODO
}

enum InboxStatus {
  RECEIVED
  APPLIED
  FAILED
}

enum InboxTargetType {
  BLOG
  IDEA
  TODO
}

enum IdeaConversionTarget {
  BLOG
  TODO
}

enum McpApprovalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum McpCredentialKind {
  STATIC
  OAUTH
}

enum McpAuditStatus {
  IN_PROGRESS
  SUCCESS
  FAILURE
  INTERRUPTED
}

enum QuestionCardState {
  NEW
  LEARNING
  REVIEW
  RELEARNING
}

enum QuestionRating {
  AGAIN
  HARD
  GOOD
  EASY
}

enum QuestionReviewSource {
  TYPED
  DIRECT_REVEAL
}

enum QuestionRevealMode {
  TYPED
  DIRECT_REVEAL
}

enum QuestionResetReason {
  CONTENT_RESET
  ANSWER_CLEARED
  ANSWER_COMPLETED
}

enum QuestionImageFieldType {
  PROMPT
  REFERENCE
}

model Post {
  id                String           @id @default(cuid())
  title             String
  content           String           @db.Text
  excerpt           String?
  slug              String           @unique
  categoryId        String?
  category          Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags              String[]
  coverImage        String?
  draftMetadata     Json?
  status            PostStatus       @default(DRAFT)
  readTime          Int              @default(1)
  publishedAt       DateTime?
  sourceInboxItemId String?          @unique
  sourceInboxItem   InboxItem?       @relation("PostSourceInbox", fields: [sourceInboxItemId], references: [id], onDelete: Restrict)
  ideaConversions   IdeaConversion[] @relation("IdeaConversionPost")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([categoryId])
}

model Category {
  id          String       @id @default(cuid())
  name        String
  type        CategoryType
  description String?
  color       String?      @default("#C97B3D")
  sortOrder   Int          @default(0)
  posts       Post[]
  todos       Todo[]
  createdAt   DateTime     @default(now())

  @@unique([type, name])
  @@index([type])
}

model Todo {
  id                 String           @id @default(cuid())
  title              String
  description        String?
  categoryId         String?
  category           Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  status             TodoStatus       @default(TODO)
  priority           Int?             @default(0)
  dueDate            DateTime?
  projectId          String?
  project            Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  completionCriteria String?
  sourceInboxItemId  String?          @unique
  sourceInboxItem    InboxItem?       @relation("TodoSourceInbox", fields: [sourceInboxItemId], references: [id], onDelete: Restrict)
  subtasks           TodoSubtask[]
  ideaConversions    IdeaConversion[] @relation("IdeaConversionTodo")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  dailyTasks         DailyTask[]

  @@index([status])
  @@index([categoryId])
  @@index([projectId])
}

model TodoSubtask {
  id        String   @id @default(cuid())
  todoId    String
  todo      Todo     @relation(fields: [todoId], references: [id], onDelete: Cascade)
  title     String   @db.VarChar(300)
  completed Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([todoId, sortOrder])
}

model User {
  id              String   @id @default(cuid())
  username        String   @unique
  passwordHash    String
  passwordVersion Int      @default(1)
  name            String
  email           String   @unique
  emailVerified   Boolean  @default(true)
  image           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  accounts           Account[]
  sessions           Session[]
  oauthClients       OauthClient[]
  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]
  oauthConsents      OauthConsent[]
  dailyPlans         DailyPlan[]
  inboxItems         InboxItem[]
  inboxEvents        InboxEvent[]
  ideas              Idea[]
  ideaConversions    IdeaConversion[]
  questions                 Question[]
  questionReviewLogs        QuestionReviewLog[]
  questionReviewTickets     QuestionReviewTicket[]
  questionAttempts          QuestionAttempt[]
  questionScheduleResetLogs QuestionScheduleResetLog[]
  questionPreference        QuestionPreference?
  questionImages            QuestionImage[]
  questionImageReferences   QuestionImageReference[]
}

model DailyQuote {
  id             Int       @id @default(autoincrement())
  quote          String    @db.Text
  category       String    @db.VarChar(32)
  author         String?   @db.VarChar(120)
  source         String?   @db.VarChar(200)
  sourceDetail   String?   @map("source_detail") @db.VarChar(200)
  usedDate       DateTime? @unique @map("used_date") @db.Date
  normalizedHash String    @unique @map("normalized_hash") @db.VarChar(64)
  status         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  plans          DailyPlan[]

  @@index([status, category])
  @@map("daily_quotes")
}

model DailyPlan {
  id            String      @id @default(cuid())
  userId        String      @map("user_id")
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  planDate      DateTime    @map("plan_date") @db.Date
  quoteId       Int?        @map("quote_id")
  quote         DailyQuote? @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  quoteText     String      @map("quote_text") @db.Text
  quoteCategory String      @map("quote_category") @db.VarChar(32)
  quoteAuthor   String?     @map("quote_author") @db.VarChar(120)
  quoteSource   String?     @map("quote_source") @db.VarChar(200)
  quoteSourceDetail String? @map("quote_source_detail") @db.VarChar(200)
  tasks         DailyTask[]
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@unique([userId, planDate])
  @@index([userId, planDate(sort: Desc)])
  @@map("daily_plans")
}

model DailyTask {
  id           String    @id @default(cuid())
  planId       String    @map("plan_id")
  plan         DailyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  slot         Int
  title        String    @db.VarChar(300)
  completedAt  DateTime? @map("completed_at")
  sourceTodoId String?   @map("source_todo_id")
  sourceTodo   Todo?     @relation(fields: [sourceTodoId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([planId, slot])
  @@unique([planId, sourceTodoId])
  @@index([sourceTodoId])
  @@map("daily_tasks")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Jwks {
  id         String    @id @default(cuid())
  publicKey  String    @db.Text
  privateKey String    @db.Text
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?
}

model OauthClient {
  id                      String   @id @default(cuid())
  clientId                String   @unique
  clientSecret            String?
  disabled                Boolean  @default(false)
  skipConsent             Boolean?
  enableEndSession        Boolean?
  subjectType             String?
  scopes                  String[]  @default([])
  userId                  String?
  user                    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  name                    String?
  uri                     String?
  icon                    String?
  contacts                String[]  @default([])
  tos                     String?
  policy                  String?
  softwareId              String?
  softwareVersion         String?
  softwareStatement       String?
  redirectUris            String[]
  postLogoutRedirectUris  String[]  @default([])
  tokenEndpointAuthMethod String?
  grantTypes              String[]  @default([])
  responseTypes           String[]  @default([])
  public                  Boolean  @default(true)
  type                    String?
  requirePKCE             Boolean  @default(true)
  referenceId             String?
  metadata                Json?

  refreshTokens OauthRefreshToken[]
  accessTokens  OauthAccessToken[]
  consents      OauthConsent[]

  @@index([userId])
  @@index([createdAt])
}

model OauthRefreshToken {
  id          String      @id @default(cuid())
  token       String      @unique
  clientId    String
  client      OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId   String?
  session     Session?    @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId String?
  expiresAt   DateTime
  createdAt   DateTime    @default(now())
  revoked     DateTime?
  authTime    DateTime?
  scopes      String[]

  accessTokens OauthAccessToken[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([expiresAt])
}

model OauthAccessToken {
  id          String             @id @default(cuid())
  token       String             @unique
  clientId    String
  client      OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId   String?
  session     Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId      String?
  user        User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId String?
  refreshId   String?
  refresh     OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  createdAt   DateTime           @default(now())
  scopes      String[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([refreshId])
  @@index([expiresAt])
}

model OauthConsent {
  id          String      @id @default(cuid())
  clientId    String
  client      OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId      String?
  user        User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId String?
  scopes      String[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([clientId, userId])
  @@index([clientId])
  @@index([userId])
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String?
  tags        String[]
  coverImage  String?
  sourceUrl   String?
  demoUrl     String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  ideas       Idea[]
  todos       Todo[]

  @@index([sortOrder])
}

model InboxItem {
  id             String          @id @default(cuid())
  ownerId        String
  owner          User            @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  kind           InboxKind
  status         InboxStatus     @default(RECEIVED)
  rawInput       String          @db.Text
  rawSha256      String          @db.Char(64)
  parsedBody     String          @db.Text
  parserVersion  Int
  requestKey     String          @db.VarChar(200)
  failureCode    String?         @db.VarChar(64)
  failureMessage String?         @db.VarChar(500)
  appliedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  execution      InboxExecution?
  events         InboxEvent[]
  sourcePost     Post?           @relation("PostSourceInbox")
  sourceIdea     Idea?           @relation("IdeaSourceInbox")
  sourceTodo     Todo?           @relation("TodoSourceInbox")

  @@unique([ownerId, requestKey])
  @@index([ownerId, createdAt(sort: Desc)])
  @@index([ownerId, kind, status, createdAt(sort: Desc)])
}

model InboxExecution {
  inboxItemId String          @id
  inboxItem   InboxItem       @relation(fields: [inboxItemId], references: [id], onDelete: Restrict)
  targetType  InboxTargetType
  targetId    String
  createdAt   DateTime        @default(now())

  @@index([targetType, targetId])
}

model InboxEvent {
  id          String    @id @default(cuid())
  inboxItemId String
  inboxItem   InboxItem @relation(fields: [inboxItemId], references: [id], onDelete: Restrict)
  actorUserId String
  actorUser   User      @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  eventType   String    @db.VarChar(64)
  metadata    Json?
  createdAt   DateTime  @default(now())

  @@index([inboxItemId, createdAt])
  @@index([actorUserId, createdAt])
}

model Idea {
  id                String           @id @default(cuid())
  ownerId           String
  owner             User             @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  title             String
  content           String           @db.Text
  tags              String[]         @default([])
  projects          Project[]
  sourceInboxItemId String?          @unique
  sourceInboxItem   InboxItem?       @relation("IdeaSourceInbox", fields: [sourceInboxItemId], references: [id], onDelete: Restrict)
  conversions       IdeaConversion[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([ownerId, createdAt(sort: Desc)])
}

model IdeaConversion {
  id         String               @id @default(cuid())
  ownerId    String
  owner      User                 @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  ideaId     String
  idea       Idea                 @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  targetType IdeaConversionTarget
  requestKey String               @db.VarChar(200)
  postId     String?              @unique
  post       Post?                @relation("IdeaConversionPost", fields: [postId], references: [id], onDelete: SetNull)
  todoId     String?              @unique
  todo       Todo?                @relation("IdeaConversionTodo", fields: [todoId], references: [id], onDelete: SetNull)
  createdAt  DateTime             @default(now())

  @@unique([ownerId, requestKey])
  @@index([ideaId, createdAt])
}

model McpCredential {
  id            String            @id
  kind          McpCredentialKind @default(STATIC)
  name          String
  secretHash    String?
  oauthClientId String?           @unique
  oauthSubject  String?
  scopes        String[]
  revokedAt     DateTime?
  lastUsedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  approvals     McpApproval[]
  auditLogs     McpAuditLog[]
  rateLimits    McpRateLimit[]
  importBundles McpImportBundle[]

  @@index([revokedAt])
  @@index([kind, revokedAt])
}

model McpApproval {
  id               String            @id @default(cuid())
  credentialId     String
  credential       McpCredential     @relation(fields: [credentialId], references: [id], onDelete: Restrict)
  toolName         String
  requiredScope    String
  status           McpApprovalStatus @default(PENDING_APPROVAL)
  payload          Json
  parameterSummary Json
  resultSummary    Json?
  executionError   String?
  processingAt     DateTime?
  reviewedAt       DateTime?
  executedAt       DateTime?
  expiresAt        DateTime
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  execution        McpExecution?
  importBundle     McpImportBundle?

  @@index([status, createdAt])
  @@index([credentialId, createdAt])
}

model McpImportBundle {
  id              String        @id
  credentialId    String
  credential      McpCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  sourceFile      String
  sourceDigest    String
  manifest        Json
  uploadTokenHash String
  approvalId      String?       @unique
  approval        McpApproval?  @relation(fields: [approvalId], references: [id], onDelete: Restrict)
  expiresAt       DateTime
  consumedAt      DateTime?
  cleanedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([credentialId, createdAt])
  @@index([expiresAt, cleanedAt])
}

model McpExecution {
  approvalId    String      @id
  approval      McpApproval @relation(fields: [approvalId], references: [id], onDelete: Restrict)
  toolName      String
  resultSummary Json
  createdAt     DateTime    @default(now())
}

model McpAuditLog {
  id               String         @id @default(cuid())
  credentialId     String?
  credential       McpCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  toolName         String
  parameterSummary Json
  resultSummary    Json?
  status           McpAuditStatus @default(IN_PROGRESS)
  success          Boolean
  errorCode        String?
  errorMessage     String?
  createdAt        DateTime       @default(now())
  completedAt      DateTime?

  @@index([credentialId, createdAt])
  @@index([toolName, createdAt])
  @@index([status, createdAt])
}

model McpRateLimit {
  credentialId String
  credential   McpCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  toolName     String
  windowStart  DateTime
  count        Int           @default(0)

  @@id([credentialId, toolName, windowStart])
  @@index([windowStart])
}

model Question {
  id                      String            @id @default(cuid())
  ownerId                 String
  owner                   User              @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  promptMarkdown          String            @db.Text
  referenceAnswerMarkdown String?           @db.Text
  enabled                 Boolean           @default(true)
  newQueueAt              DateTime?
  latestRating            QuestionRating?
  contentVersion          Int               @default(1)
  scheduleVersion         Int               @default(1)
  dueAt                   DateTime
  stability               Float             @default(0)
  difficulty              Float             @default(0)
  elapsedDays             Int               @default(0)
  scheduledDays           Int               @default(0)
  learningSteps           Int               @default(0)
  reps                    Int               @default(0)
  lapses                  Int               @default(0)
  state                   QuestionCardState @default(NEW)
  lastReviewAt            DateTime?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  reviewLogs      QuestionReviewLog[]
  reviewTickets   QuestionReviewTicket[]
  attempts        QuestionAttempt[]
  scheduleResets  QuestionScheduleResetLog[]
  imageReferences QuestionImageReference[]

  @@unique([id, ownerId])
  @@index([ownerId, enabled, state, dueAt, id])
  @@index([ownerId, enabled, newQueueAt, id])
  @@index([ownerId, updatedAt(sort: Desc), id])
}

model QuestionReviewTicket {
  id                String                @id @default(cuid())
  reviewKey         String                @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId           String
  owner             User                  @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  questionId        String
  question          Question              @relation(fields: [questionId, ownerId], references: [id, ownerId], onDelete: Restrict)
  contentVersion    Int
  scheduleVersion   Int
  issuedAt          DateTime              @default(now())
  expiresAt         DateTime
  answerDigest      String?               @db.Char(64)
  revealMode        QuestionRevealMode?
  revealedAt        DateTime?
  cancelledAt       DateTime?
  consumedAt        DateTime?
  successorTicketId String?               @unique
  successorTicket   QuestionReviewTicket? @relation("QuestionTicketSuccessor", fields: [successorTicketId, ownerId], references: [id, ownerId], onDelete: Restrict)
  predecessorTicket QuestionReviewTicket? @relation("QuestionTicketSuccessor")
  reviewLog         QuestionReviewLog?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@unique([id, ownerId])
  @@unique([reviewKey, questionId, ownerId])
  @@unique([successorTicketId, ownerId])
  @@index([ownerId, expiresAt])
  @@index([questionId, issuedAt(sort: Desc)])
}

model QuestionReviewLog {
  id                    String               @id @default(cuid())
  reviewKey             String               @unique @db.Uuid
  questionId            String
  ownerId               String
  owner                 User                 @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  question              Question             @relation(fields: [questionId, ownerId], references: [id, ownerId], onDelete: Restrict)
  ticket                QuestionReviewTicket @relation(fields: [reviewKey, questionId, ownerId], references: [reviewKey, questionId, ownerId], onDelete: Restrict)
  source                QuestionReviewSource
  rating                QuestionRating
  stateBefore           QuestionCardState
  reviewedAt            DateTime
  reviewDate            DateTime             @db.Date
  beforeCard            Json
  afterCard             Json
  fsrsReviewLog         Json
  schedulerVersion      String               @db.VarChar(32)
  parametersSnapshot    Json
  contentVersion        Int
  scheduleVersionBefore Int
  scheduleVersionAfter  Int
  revisionCount         Int                  @default(0)
  ratingLockedAt        DateTime?
  advancedAt            DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  attempt               QuestionAttempt?

  @@unique([id, questionId, ownerId])
  @@unique([reviewKey, questionId, ownerId])
  @@index([ownerId, reviewDate])
  @@index([ownerId, reviewDate, stateBefore])
  @@index([questionId, reviewedAt(sort: Desc), id])
}

model QuestionAttempt {
  id             String            @id @default(cuid())
  ownerId        String
  owner          User              @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  questionId     String
  question       Question          @relation(fields: [questionId, ownerId], references: [id, ownerId], onDelete: Restrict)
  reviewLogId    String            @unique
  reviewLog      QuestionReviewLog @relation(fields: [reviewLogId, questionId, ownerId], references: [id, questionId, ownerId], onDelete: Restrict)
  answerMarkdown String            @db.Text
  createdAt      DateTime          @default(now())

  @@unique([reviewLogId, questionId, ownerId])
  @@index([questionId, createdAt(sort: Desc), id])
  @@index([ownerId, createdAt(sort: Desc)])
}

model QuestionScheduleResetLog {
  id                    String              @id @default(cuid())
  ownerId               String
  owner                 User                @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  questionId            String
  question              Question            @relation(fields: [questionId, ownerId], references: [id, ownerId], onDelete: Restrict)
  reason                QuestionResetReason
  resetAt               DateTime
  beforeCard            Json
  afterCard             Json
  contentVersionBefore  Int
  contentVersionAfter   Int
  scheduleVersionBefore Int
  scheduleVersionAfter  Int
  createdAt             DateTime            @default(now())

  @@index([questionId, resetAt(sort: Desc), id])
  @@index([ownerId, resetAt(sort: Desc)])
}

model QuestionPreference {
  userId        String   @id
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyNewLimit Int      @default(10)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model QuestionImage {
  id             String                   @id @default(cuid())
  ownerId        String
  owner          User                     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  storageKey     String                   @unique @db.VarChar(200)
  mimeType       String                   @db.VarChar(64)
  byteSize       Int
  sha256         String                   @db.Char(64)
  createdAt      DateTime                 @default(now())
  unreferencedAt DateTime?                @default(now())
  references     QuestionImageReference[]

  @@unique([id, ownerId])
  @@index([ownerId, createdAt(sort: Desc)])
  @@index([unreferencedAt])
}

model QuestionImageReference {
  id         String                 @id @default(cuid())
  ownerId    String
  owner      User                   @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  imageId    String
  image      QuestionImage          @relation(fields: [imageId, ownerId], references: [id, ownerId], onDelete: Restrict)
  questionId String
  question   Question               @relation(fields: [questionId, ownerId], references: [id, ownerId], onDelete: Restrict)
  fieldType  QuestionImageFieldType
  createdAt  DateTime               @default(now())

  @@unique([imageId, questionId, fieldType])
  @@index([questionId, fieldType])
  @@index([ownerId, imageId])
}
