# 本地开发
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/blog?schema=public"
SEED_PASSWORD="use-a-unique-password-with-at-least-15-characters"
SESSION_SECRET="replace-with-at-least-32-random-characters"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_GITHUB_URL="https://github.com/666666999999666"

# 远程 /api/mcp 使用 OAuth，客户端只配置 URL，不需要固定 credential。
# 仅本地 Markdown/图片导入器需要以下变量（真实 credential 在 /admin/mcp 创建，不要提交）。
# BLOG_MCP_CREDENTIAL="qzmcp_v1_<credential-id>_<secret>"
# MCP_REMOTE_URL="https://liaoqizai.site"
# MCP_MARKDOWN_ROOT="C:/Users/you/Documents/blog-drafts"
# MCP_IMAGE_ROOT="C:/Users/you/Documents/blog-drafts"
# 以下治理参数由线上 Web 服务读取；远程 MCP Client 无法覆盖它们。
# MCP_APPROVAL_TTL_HOURS=24
# MCP_CREDENTIAL_RATE_LIMIT_PER_MINUTE=60
# MCP_SEARCH_RATE_LIMIT_PER_MINUTE=30
# MCP_WRITE_RATE_LIMIT_PER_MINUTE=10

# 生产服务器 .env 还必须配置以下变量。不要提交真实值。
# WEB_IMAGE=ccr.ccs.tencentyun.com/lqzzql/web@sha256:<immutable-digest>
# DB_NAME=blog
# DB_USER=blog
# DB_PASSWORD=<unique-database-password>
# DATABASE_URL=postgresql://blog:<URL-encoded-password>@db:5432/blog?schema=public
# SESSION_SECRET=<at-least-32-random-characters>
# NEXT_PUBLIC_SITE_URL=https://liaoqizai.site
# NEXT_PUBLIC_GITHUB_URL=https://github.com/666666999999666
